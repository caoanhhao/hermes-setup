# jev-ultrafast cho user `hermes`.
# Copy thành ~hermes/.config/jev-ultrafast/.env, rồi `chmod 600`.
# Dựa trên .env.example của browser-use/jev-ultrafast @ 8251e272 (2026-10-31).

# --- Jev (System One) qua OpenCode Zen ---
# Key OpenCode riêng cho agent (oc_sk_...). Code đọc key qua os.environ["TYPESAFE_API_KEY"].
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13-free
# Biến này chỉ có tác dụng khi đã áp patches/jev-ultrafast-typesafe-base-url.patch.
# Chưa áp patch thì upstream vẫn gọi https://api.typesafe.ai/v1/systemone.
TYPESAFE_BASE_URL=https://opencode.ai/zen/v1/systemone

# --- Text helper (chỉ dùng cho TYPE_TEXT): Ollama local, API OpenAI-compatible ---
# Ollama không cần key, nhưng code báo lỗi nếu biến này trống, nên điền giá trị bất kỳ.
TEXT_MODEL_API_KEY=ollama
TEXT_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# Cùng model chat của Hermes (đã có trong Ollama). Nên dùng model không "thinking", vì Ollama có thể bỏ qua cờ reasoning.
TEXT_MODEL=Qwen3.5-9B-DeepSeek-V4-Flash-GGUF-50k:latest
TEXT_MODEL_REASONING=none

# --- browser-harness: Chromium riêng của agent (bot-chromium.service) ---
BU_CDP_URL=http://127.0.0.1:9222
BH_TELEMETRY=0
